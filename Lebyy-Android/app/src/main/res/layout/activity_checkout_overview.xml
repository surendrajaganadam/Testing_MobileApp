<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lebyy_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/lebyy_bg_2"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/review_title"
        app:titleTextColor="@color/lebyy_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/order_items"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overviewItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-ReviewItem"
                android:textColor="@color/lebyy_text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/coupon"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewCoupons"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:contentDescription="test-VIEW COUPONS"
                android:text="@string/view_coupons"
                android:textAllCaps="true"
                android:textColor="@color/lebyy_primary"
                app:strokeColor="@color/lebyy_primary" />

            <LinearLayout
                android:id="@+id/couponList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-CouponList"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/or_enter_coupon"
                android:textColor="@color/lebyy_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputCoupon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-Coupon"
                        android:hint="@string/coupon_code"
                        android:inputType="textCapCharacters" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonApplyCoupon"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="test-APPLY COUPON"
                    android:text="@string/apply_coupon"
                    android:textAllCaps="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/couponStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="test-CouponApplied"
                android:text="@string/coupon_hint"
                android:textColor="@color/lebyy_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/shipping_information"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shippingInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-ReviewShipping"
                android:textColor="@color/lebyy_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/payment_information"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/paymentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-ReviewPayment"
                android:textColor="@color/lebyy_muted" />

            <TextView
                android:id="@+id/overviewSubtotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:contentDescription="test-ReviewSubtotal"
                android:textColor="@color/lebyy_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/overviewDiscount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="test-ReviewDiscount"
                android:textColor="@color/lebyy_success"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/overviewTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-ReviewTotal"
                android:textColor="@color/lebyy_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPlaceOrder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:contentDescription="test-PLACE ORDER"
                android:text="@string/place_order"
                android:textAllCaps="true"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:contentDescription="test-CANCEL"
                android:text="@string/cancel"
                android:textAllCaps="true"
                android:textColor="@color/lebyy_primary"
                app:strokeColor="@color/lebyy_primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
