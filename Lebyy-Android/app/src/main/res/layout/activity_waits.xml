<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="test-WaitsScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lebyy_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lebyy_bg_2"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/waits_title"
            app:titleTextColor="@color/lebyy_text" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/contentRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Delayed Content" android:textColor="@color/lebyy_primary" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/delayLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:contentDescription="test-DelayStepper" android:text="Delay: 3s" android:textColor="@color/lebyy_text" android:layout_marginBottom="4dp"/>
                <SeekBar android:id="@+id/delaySeek" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="7" android:progress="2" android:contentDescription="test-DelaySeek" android:layout_marginBottom="10dp"/>
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loadDelayed"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="test-LoadDelayed"
                    android:text="Load After Delay"
                    android:textColor="@color/lebyy_bg"
                    app:backgroundTint="@color/lebyy_accent"
                    app:cornerRadius="12dp" />
                <ProgressBar android:id="@+id/loadingSpinner" style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" android:contentDescription="test-LoadingSpinner" android:visibility="gone" android:layout_marginBottom="8dp"/>
                
                <TextView
                    android:id="@+id/delayedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="test-DelayedContent"
                    android:text=""
                    android:textColor="@color/lebyy_success"
                    android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Network Error / Retry" android:textColor="@color/lebyy_primary" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simulateNetworkFail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="test-SimulateNetworkFail"
                    android:text="Simulate Network Fail"
                    android:textColor="@color/lebyy_bg"
                    app:backgroundTint="@color/lebyy_primary"
                    app:cornerRadius="12dp" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simulateNetworkSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="test-SimulateNetworkSuccess"
                    android:text="Simulate Network Success"
                    android:textColor="@color/lebyy_bg"
                    app:backgroundTint="@color/lebyy_accent"
                    app:cornerRadius="12dp" />
                
                <TextView
                    android:id="@+id/networkStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="test-NetworkStatus-Idle"
                    android:text="Status: Idle"
                    android:textColor="@color/lebyy_muted"
                    android:textSize="15sp" />
                <TextView android:id="@+id/networkErrorMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:contentDescription="test-NetworkErrorMessage" android:text="Could not reach server" android:textColor="@color/lebyy_muted" android:visibility="gone" android:layout_marginBottom="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/networkRetry"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="test-NetworkRetry"
                    android:text="Retry"
                    android:visibility="gone"
                    android:textColor="@color/lebyy_bg"
                    app:backgroundTint="@color/lebyy_accent"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/lebyy_surface"
        android:contentDescription="test-Menu-panel" />
</androidx.drawerlayout.widget.DrawerLayout>
