<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lebyy_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lebyy_bg_2"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/forms_title"
            app:titleTextColor="@color/lebyy_text" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Input"
                    android:textColorHint="@color/lebyy_muted"
                    app:boxBackgroundColor="@color/lebyy_surface"
                    app:boxStrokeColor="@color/lebyy_primary"
                    app:hintTextColor="@color/lebyy_primary"
                    app:placeholderText="@string/forms_input_hint"
                    app:placeholderTextColor="@color/lebyy_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-Input"
                        android:inputType="text"
                        android:textColor="@color/lebyy_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:checked="false"
                    android:contentDescription="test-Switch"
                    android:text="@string/forms_switch"
                    android:textColor="@color/lebyy_text" />

                <TextView
                    android:id="@+id/switchStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="test-SwitchStatus"
                    android:text="Switch status: OFF"
                    android:textColor="@color/lebyy_muted"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Dropdown"
                    android:textColorHint="@color/lebyy_muted"
                    app:boxBackgroundColor="@color/lebyy_surface"
                    app:boxStrokeColor="@color/lebyy_primary"
                    app:hintTextColor="@color/lebyy_primary"
                    app:placeholderText="@string/forms_dropdown_hint"
                    app:placeholderTextColor="@color/lebyy_muted"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:contentDescription="test-Dropdown"
                        android:gravity="center_vertical"
                        android:inputType="none"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/lebyy_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Checkboxes"
                    android:textColor="@color/lebyy_muted"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/checkboxOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="test-Checkbox-1"
                    android:text="Option A"
                    android:textColor="@color/lebyy_text" />

                <CheckBox
                    android:id="@+id/checkboxTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="test-Checkbox-2"
                    android:text="Option B"
                    android:textColor="@color/lebyy_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Radio buttons"
                    android:textColor="@color/lebyy_muted"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="test-RadioGroup">

                    <RadioButton
                        android:id="@+id/radioOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-Radio-1"
                        android:text="Radio 1"
                        android:textColor="@color/lebyy_text" />

                    <RadioButton
                        android:id="@+id/radioTwo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-Radio-2"
                        android:text="Radio 2"
                        android:textColor="@color/lebyy_text" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonActive"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="test-Active"
                    android:text="@string/forms_active"
                    android:textColor="@color/lebyy_bg"
                    app:backgroundTint="@color/lebyy_accent"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonInactive"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="test-Inactive"
                    android:text="@string/forms_inactive"
                    android:textColor="@color/lebyy_muted"
                    app:backgroundTint="@color/lebyy_surface_2"
                    app:cornerRadius="12dp" />

                <TextView
                    android:id="@+id/formsResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:contentDescription="test-FormsResult"
                    android:text="Result: —"
                    android:textColor="@color/lebyy_accent"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/lebyy_surface"
        android:contentDescription="test-Menu-panel" />
</androidx.drawerlayout.widget.DrawerLayout>
