<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lebyy_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/rowText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:contentDescription="test-SwipeRow"
        android:text="Swipe Row"
        android:textColor="@color/lebyy_text"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/swipeEditAction"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:contentDescription="test-SwipeEditAction"
        android:importantForAccessibility="yes"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="72dp"
        android:text="Edit"
        android:textColor="@color/lebyy_bg"
        android:visibility="gone"
        app:backgroundTint="@color/lebyy_primary"
        app:cornerRadius="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/swipeDeleteAction"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:contentDescription="test-SwipeDeleteAction"
        android:importantForAccessibility="yes"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="72dp"
        android:text="Delete"
        android:textColor="@color/lebyy_bg"
        android:visibility="gone"
        app:backgroundTint="@color/lebyy_accent"
        app:cornerRadius="10dp" />
</LinearLayout>
