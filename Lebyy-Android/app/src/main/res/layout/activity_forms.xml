<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lebyy_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lebyy_bg_2"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/forms_title"
            app:titleTextColor="@color/lebyy_text" />

        <ScrollView
            android:id="@+id/formsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/formsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/formsResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="test-FormsResult"
                    android:text="Result: —"
                    android:textColor="@color/lebyy_accent"
                    android:textSize="15sp" />

                <!-- Text Fields -->
                <LinearLayout
                    android:id="@+id/sectionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Plain text field"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Type something"
                        android:textColorHint="@color/lebyy_muted"
                        app:boxBackgroundColor="@color/lebyy_surface"
                        app:boxStrokeColor="@color/lebyy_primary"
                        app:hintTextColor="@color/lebyy_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="test-Input"
                            android:inputType="text"
                            android:textColor="@color/lebyy_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Secure field"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Password"
                        android:textColorHint="@color/lebyy_muted"
                        app:boxBackgroundColor="@color/lebyy_surface"
                        app:boxStrokeColor="@color/lebyy_primary"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/lebyy_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/secureInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="test-SecureInput"
                            android:inputType="textPassword"
                            android:textColor="@color/lebyy_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Email field"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Email"
                        android:textColorHint="@color/lebyy_muted"
                        app:boxBackgroundColor="@color/lebyy_surface"
                        app:boxStrokeColor="@color/lebyy_primary"
                        app:hintTextColor="@color/lebyy_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="test-EmailInput"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/lebyy_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Multiline"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Notes"
                        android:textColorHint="@color/lebyy_muted"
                        app:boxBackgroundColor="@color/lebyy_surface"
                        app:boxStrokeColor="@color/lebyy_primary"
                        app:hintTextColor="@color/lebyy_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/multilineInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="test-MultilineInput"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textColor="@color/lebyy_text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Switches -->
                <LinearLayout
                    android:id="@+id/sectionSwitches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Default switch"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:contentDescription="test-Switch"
                        android:text="@string/forms_switch"
                        android:textColor="@color/lebyy_text" />

                    <TextView
                        android:id="@+id/switchStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:contentDescription="test-SwitchStatus"
                        android:text="Switch status: OFF"
                        android:textColor="@color/lebyy_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Labeled switch"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchLabeled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:checked="true"
                        android:contentDescription="test-Switch-Labeled"
                        android:text="Enable notifications"
                        android:textColor="@color/lebyy_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Disabled switch"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDisabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:checked="false"
                        android:contentDescription="test-Switch-Disabled"
                        android:enabled="false"
                        android:text="Disabled"
                        android:textColor="@color/lebyy_muted" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Checkbox-style toggles"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/checkboxOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-Checkbox-1"
                        android:text="Option A"
                        android:textColor="@color/lebyy_text" />

                    <CheckBox
                        android:id="@+id/checkboxTwo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-Checkbox-2"
                        android:text="Option B"
                        android:textColor="@color/lebyy_text" />
                </LinearLayout>

                <!-- Sliders -->
                <LinearLayout
                    android:id="@+id/sectionSliders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Continuous (0–100)"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-Slider"
                        android:max="100"
                        android:progress="50" />

                    <TextView
                        android:id="@+id/sliderValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:contentDescription="test-SliderValue"
                        android:text="Slider value: 50"
                        android:textColor="@color/lebyy_accent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Stepped (1–5)"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/sliderStepped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-Slider-Stepped"
                        android:max="4"
                        android:progress="2" />

                    <TextView
                        android:id="@+id/sliderSteppedValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-SliderSteppedValue"
                        android:text="Stepped value: 3"
                        android:textColor="@color/lebyy_accent" />
                </LinearLayout>

                <!-- Date & Time -->
                <LinearLayout
                    android:id="@+id/sectionPickers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Date picker"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPickDate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:contentDescription="test-DatePicker"
                        android:text="Pick Date"
                        android:textColor="@color/lebyy_bg"
                        app:backgroundTint="@color/lebyy_primary"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/dateValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:contentDescription="test-DateValue"
                        android:text="Selected date: —"
                        android:textColor="@color/lebyy_muted" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Time picker"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPickTime"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:contentDescription="test-TimePicker"
                        android:text="Pick Time"
                        android:textColor="@color/lebyy_bg"
                        app:backgroundTint="@color/lebyy_primary"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/timeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-TimeValue"
                        android:text="Selected time: —"
                        android:textColor="@color/lebyy_muted" />
                </LinearLayout>

                <!-- Selection -->
                <LinearLayout
                    android:id="@+id/sectionSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Dropdown / menu"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Dropdown"
                        android:textColorHint="@color/lebyy_muted"
                        app:boxBackgroundColor="@color/lebyy_surface"
                        app:boxStrokeColor="@color/lebyy_primary"
                        app:hintTextColor="@color/lebyy_primary"
                        app:placeholderText="@string/forms_dropdown_hint"
                        app:placeholderTextColor="@color/lebyy_muted">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:contentDescription="test-Dropdown"
                            android:gravity="center_vertical"
                            android:inputType="none"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/lebyy_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Radio / segmented"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/radioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:contentDescription="test-RadioGroup">

                        <RadioButton
                            android:id="@+id/radioOne"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="test-Radio-1"
                            android:text="Radio 1"
                            android:textColor="@color/lebyy_text" />

                        <RadioButton
                            android:id="@+id/radioTwo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="test-Radio-2"
                            android:text="Radio 2"
                            android:textColor="@color/lebyy_text" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Buttons"
                        android:textColor="@color/lebyy_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonActive"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="test-Active"
                        android:text="@string/forms_active"
                        android:textColor="@color/lebyy_bg"
                        app:backgroundTint="@color/lebyy_accent"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonInactive"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:contentDescription="test-Inactive"
                        android:text="@string/forms_inactive"
                        android:textColor="@color/lebyy_muted"
                        app:backgroundTint="@color/lebyy_surface_2"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Validation -->
                <LinearLayout
                    android:id="@+id/sectionValidation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/validationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@color/lebyy_surface"
                        android:contentDescription="test-ValidationName"
                        android:hint="Full name"
                        android:padding="14dp"
                        android:textColor="@color/lebyy_text"
                        android:textColorHint="@color/lebyy_muted" />

                    <EditText
                        android:id="@+id/validationEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@color/lebyy_surface"
                        android:contentDescription="test-ValidationEmail"
                        android:hint="Email"
                        android:inputType="textEmailAddress"
                        android:padding="14dp"
                        android:textColor="@color/lebyy_text"
                        android:textColorHint="@color/lebyy_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/validationSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="test-ValidationSubmit"
                        android:text="Submit Validation"
                        android:textColor="@color/lebyy_bg"
                        app:backgroundTint="@color/lebyy_accent"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/validationError1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-ValidationError-1"
                        android:textColor="#FF8A80"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/validationError2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-ValidationError-2"
                        android:textColor="#FF8A80"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/validationSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="test-ValidationSuccess"
                        android:text="Form looks good"
                        android:textColor="@color/lebyy_success"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- OTP -->
                <LinearLayout
                    android:id="@+id/sectionOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enter 1234 for success"
                        android:textColor="@color/lebyy_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/otpGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:contentDescription="test-OTPGroup"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/otp1"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@color/lebyy_surface"
                            android:contentDescription="test-OTP-1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/lebyy_text" />

                        <EditText
                            android:id="@+id/otp2"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@color/lebyy_surface"
                            android:contentDescription="test-OTP-2"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/lebyy_text" />

                        <EditText
                            android:id="@+id/otp3"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@color/lebyy_surface"
                            android:contentDescription="test-OTP-3"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/lebyy_text" />

                        <EditText
                            android:id="@+id/otp4"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@color/lebyy_surface"
                            android:contentDescription="test-OTP-4"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/lebyy_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/otpValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:contentDescription="test-OTPValue"
                        android:text="OTP value: "
                        android:textColor="@color/lebyy_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/otpVerify"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="test-OTPVerify"
                        android:text="Verify OTP"
                        android:textColor="@color/lebyy_bg"
                        app:backgroundTint="@color/lebyy_accent"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/lebyy_surface"
        android:contentDescription="test-Menu-panel" />
</androidx.drawerlayout.widget.DrawerLayout>
