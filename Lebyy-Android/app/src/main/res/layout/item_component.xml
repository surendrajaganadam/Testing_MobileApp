<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lebyy_surface"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="8dp">

    <!--
      Title + subtitle are separate a11y nodes using their visible text
      (so Inspector shows "Alerts & Dialogs" then the description).
      The test-* locator lives on a 1dp sibling so automation still works
      without replacing the title's accessible name.
    -->
    <TextView
        android:id="@+id/componentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:textColor="@color/lebyy_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/componentSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="yes"
        android:textColor="@color/lebyy_muted"
        android:textSize="13sp" />

    <View
        android:id="@+id/componentA11yId"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:importantForAccessibility="yes"
        android:focusable="true" />
</LinearLayout>
