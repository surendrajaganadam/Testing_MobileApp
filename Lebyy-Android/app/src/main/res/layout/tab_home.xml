<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lebyy_bg"
    android:contentDescription="test-HomeScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.35" />

        <ImageView
            android:id="@+id/homeLogo"
            android:layout_width="168dp"
            android:layout_height="144dp"
            android:contentDescription="test-HomeLogo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_lebyy" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="test-HomeBrand"
                android:letterSpacing="0.28"
                android:text="LEBYY"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="30sp"
                android:textStyle="normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@color/lebyy_accent"
                android:paddingHorizontal="9dp"
                android:paddingVertical="7dp"
                android:text="APP"
                android:textColor="@color/lebyy_bg"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:contentDescription="test-HomeBlurb"
            android:gravity="center"
            android:text="Demo app for mobile automation practice"
            android:textColor="#B8FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/homeWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="test-HomeWelcome"
            android:gravity="center"
            android:text="Welcome to Lebyy Practice App"
            android:textColor="@color/lebyy_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="test-HomeIcon-iOS"
                android:src="@drawable/ic_platform_apple"
                android:tint="@color/lebyy_accent" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="40dp"
                android:contentDescription="test-HomeIcon-Android"
                android:src="@drawable/ic_platform_android"
                android:tint="@color/lebyy_accent" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/homeSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="test-HomeSupport"
            android:padding="8dp"
            android:text="Support"
            android:textColor="#C7FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/homeGitHub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="test-HomeGitHub"
            android:padding="8dp"
            android:text="GitHub"
            android:textColor="#80FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
