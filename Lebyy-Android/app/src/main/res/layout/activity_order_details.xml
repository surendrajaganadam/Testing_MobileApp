<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lebyy_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/lebyy_bg_2"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/order_details_title"
        app:titleTextColor="@color/lebyy_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/orderConfirmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="test-OrderConfirmed"
                android:text="@string/order_confirmed"
                android:textColor="@color/lebyy_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Stable anchor for automation (always test-OrderId). -->
            <TextView
                android:id="@+id/orderIdLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-OrderId"
                android:text="@string/order_id_label"
                android:textColor="@color/lebyy_muted"
                android:textSize="12sp" />

            <!-- Value + unique attr test-OrderId-{id} set in code. -->
            <TextView
                android:id="@+id/orderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="test-OrderDate"
                android:textColor="@color/lebyy_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/order_items"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-OrderItem"
                android:textColor="@color/lebyy_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/shipping_information"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderShipping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-OrderShipping"
                android:textColor="@color/lebyy_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/payment_information"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-OrderPayment"
                android:textColor="@color/lebyy_muted" />

            <TextView
                android:id="@+id/orderSubtotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:contentDescription="test-OrderSubtotal"
                android:textColor="@color/lebyy_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/orderDiscount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="test-OrderDiscount"
                android:textColor="@color/lebyy_success"
                android:visibility="gone" />

            <TextView
                android:id="@+id/orderTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="test-OrderTotal"
                android:textColor="@color/lebyy_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancelOrder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:contentDescription="test-CANCEL ORDER"
                android:text="@string/cancel_order"
                android:textAllCaps="true"
                android:textColor="@color/lebyy_bg"
                android:visibility="gone"
                app:backgroundTint="@color/lebyy_accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOrderHistory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:contentDescription="test-ORDER HISTORY"
                android:text="@string/order_history"
                android:textAllCaps="true"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
