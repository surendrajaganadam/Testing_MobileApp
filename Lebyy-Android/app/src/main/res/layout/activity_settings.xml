<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="test-SettingsScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lebyy_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lebyy_bg_2"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/settings_title"
            app:titleTextColor="@color/lebyy_text" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/contentRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Profile" android:textColor="@color/lebyy_primary" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/displayName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:contentDescription="test-DisplayName" android:hint="Display name"
                    android:textColor="@color/lebyy_text" android:textColorHint="@color/lebyy_muted"
                    android:background="@color/lebyy_surface" android:padding="14dp" android:layout_marginBottom="10dp"/>
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="test-SaveProfile"
                    android:text="Save Profile"
                    android:textColor="@color/lebyy_bg"
                    app:backgroundTint="@color/lebyy_accent"
                    app:cornerRadius="12dp" />
                
                <TextView
                    android:id="@+id/profileSaved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="test-ProfileSaved"
                    android:text=""
                    android:textColor="@color/lebyy_success"
                    android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Session Timeout" android:textColor="@color/lebyy_primary" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sessionTimeoutToggle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:contentDescription="test-SessionTimeoutToggle" android:text="Enable auto logout" android:textColor="@color/lebyy_text" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/sessionTimeoutLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:contentDescription="test-SessionTimeoutLabel" android:text="Timeout: 60s" android:textColor="@color/lebyy_text" android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sessionTimeoutMinus"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="test-SessionTimeoutStepper-Minus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="−"
                        android:textColor="@color/lebyy_primary"
                        android:textSize="20sp"
                        app:backgroundTint="@color/lebyy_surface"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/lebyy_primary"
                        app:strokeWidth="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sessionTimeoutPlus"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:contentDescription="test-SessionTimeoutStepper-Plus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+"
                        android:textColor="@color/lebyy_primary"
                        android:textSize="20sp"
                        app:backgroundTint="@color/lebyy_surface"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/lebyy_primary"
                        app:strokeWidth="2dp" />
                </LinearLayout>

                <SeekBar android:id="@+id/sessionTimeoutSeek" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="11" android:progress="5" android:contentDescription="test-SessionTimeoutStepper" android:layout_marginBottom="10dp"/>
                
                <TextView
                    android:id="@+id/sessionCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="test-SessionCountdown"
                    android:text="Logs out in: —"
                    android:textColor="@color/lebyy_accent"
                    android:textSize="15sp" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetSessionTimer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="test-ResetSessionTimer"
                    android:text="Reset Session Timer"
                    android:textColor="@color/lebyy_bg"
                    app:backgroundTint="@color/lebyy_primary"
                    app:cornerRadius="12dp" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forceLogout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="test-ForceLogout"
                    android:text="Force Logout Now"
                    android:textColor="@color/lebyy_muted"
                    app:backgroundTint="@color/lebyy_surface_2"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/lebyy_surface"
        android:contentDescription="test-Menu-panel" />
</androidx.drawerlayout.widget.DrawerLayout>
