<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:contentDescription="test-HomeScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.28" />

        <ImageView
            android:id="@+id/homeLogo"
            android:layout_width="210dp"
            android:layout_height="180dp"
            android:contentDescription="test-HomeLogo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_lebyy" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="test-HomeBrand"
                android:letterSpacing="0.12"
                android:text="LEBYY"
                android:textAllCaps="true"
                android:textColor="@color/lebyy_primary"
                android:textSize="42sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_home_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:text="APP"
                android:textColor="@color/lebyy_bg"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:contentDescription="test-HomeWelcome"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:text="Welcome to Lebyy Practice App"
            android:textColor="@color/lebyy_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="15sp"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeStepGranularity="1sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="test-HomeBlurb"
            android:gravity="center"
            android:text="Demo app for mobile automation practice"
            android:textColor="@color/lebyy_text"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="test-HomeIcon-iOS"
                android:src="@drawable/ic_platform_apple"
                android:tint="@color/lebyy_primary" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="44dp"
                android:contentDescription="test-HomeIcon-Android"
                android:src="@drawable/ic_platform_android"
                android:tint="@color/lebyy_primary" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/homeSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="test-HomeSupport"
            android:padding="10dp"
            android:text="Support"
            android:textColor="@color/lebyy_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeGitHub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:contentDescription="test-HomeGitHub"
            android:padding="10dp"
            android:text="GitHub"
            android:textColor="@color/lebyy_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
