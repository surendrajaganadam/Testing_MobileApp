<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lebyy_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lebyy_bg_2"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/gestures_title"
            app:titleTextColor="@color/lebyy_text" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/gestureResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:contentDescription="test-GestureResult"
                android:text="@string/gesture_result_idle"
                android:textColor="@color/lebyy_accent"
                android:textSize="16sp" />

            <FrameLayout
                android:id="@+id/longPressTarget"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="20dp"
                android:background="@color/lebyy_surface"
                android:contentDescription="test-LongPress"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/long_press_hint"
                    android:textColor="@color/lebyy_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/doubleTapTarget"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:background="@color/lebyy_surface_2"
                android:contentDescription="test-DoubleTap"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/double_tap_hint"
                    android:textColor="@color/lebyy_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Drag &amp; Drop" android:textColor="@color/lebyy_primary" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <FrameLayout android:id="@+id/dropTarget" android:layout_width="match_parent" android:layout_height="140dp"
                android:background="@color/lebyy_surface" android:contentDescription="test-DropTarget" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/dropLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="Drop here" android:textColor="@color/lebyy_muted"/>
                <TextView android:id="@+id/dragItem" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:background="@color/lebyy_accent" android:padding="14dp"
                    android:text="Drag me" android:textColor="@color/lebyy_bg" android:contentDescription="test-DragItem"/>
            </FrameLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/resetDragDrop"
                android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="test-ResetDragDrop"
                android:text="Reset Drag Drop" android:textColor="@color/lebyy_muted" app:backgroundTint="@color/lebyy_surface_2" app:cornerRadius="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Pinch / Zoom" android:textColor="@color/lebyy_primary" android:textStyle="bold"/>
            <ImageView android:id="@+id/pinchImage" android:layout_width="match_parent" android:layout_height="160dp"
                android:contentDescription="test-PinchImage" android:scaleType="fitCenter" android:src="@drawable/course_1" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/pinchValue" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:contentDescription="test-PinchValue" android:text="Zoom: 1.00x" android:textColor="@color/lebyy_accent"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/resetPinch"
                android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="test-ResetPinch"
                android:text="Reset Zoom" android:textColor="@color/lebyy_muted" app:backgroundTint="@color/lebyy_surface_2" app:cornerRadius="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Multi-touch" android:textColor="@color/lebyy_primary" android:textStyle="bold"/>
            <FrameLayout android:id="@+id/multiTouch" android:layout_width="match_parent" android:layout_height="100dp"
                android:background="@color/lebyy_surface" android:contentDescription="test-MultiTouch" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:text="Two-finger tap here" android:textColor="@color/lebyy_primary"/>
            </FrameLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/simulateMultiTouch"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
                android:contentDescription="test-SimulateMultiTouch" android:text="Simulate 2-Finger Tap"
                android:textColor="@color/lebyy_bg" app:backgroundTint="@color/lebyy_primary" app:cornerRadius="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Context Menu" android:textColor="@color/lebyy_primary" android:textStyle="bold"/>
            <TextView android:id="@+id/contextMenuTarget" android:layout_width="match_parent" android:layout_height="80dp"
                android:layout_marginTop="8dp" android:background="@color/lebyy_surface" android:gravity="center"
                android:contentDescription="test-ContextMenuTarget" android:text="Long-press for context menu" android:textColor="@color/lebyy_text"/>
        </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/lebyy_surface"
        android:contentDescription="test-Menu-panel" />
</androidx.drawerlayout.widget.DrawerLayout>
