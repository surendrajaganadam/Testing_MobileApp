<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lebyy_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/lebyy_bg_2"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/overview_title"
        app:titleTextColor="@color/lebyy_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/overviewItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/lebyy_text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/payment_information"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/payment_card"
                android:textColor="@color/lebyy_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/shipping_information"
                android:textColor="@color/lebyy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shippingInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/lebyy_text" />

            <TextView
                android:id="@+id/overviewTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/lebyy_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Spacer so FINISH sits below the fold on small phones -->
            <View
                android:layout_width="match_parent"
                android:layout_height="280dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFinish"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:contentDescription="test-FINISH"
                android:text="@string/finish"
                android:textAllCaps="true"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:contentDescription="test-CANCEL"
                android:text="@string/cancel"
                android:textAllCaps="true"
                android:textColor="@color/lebyy_primary"
                app:strokeColor="@color/lebyy_primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
