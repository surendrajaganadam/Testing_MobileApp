<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="test-AlertsScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lebyy_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lebyy_bg_2"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/alerts_title"
            app:titleTextColor="@color/lebyy_text" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Practice native Android alert dialogs"
                android:textColor="@color/lebyy_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSimpleAlert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="test-Alert"
                android:text="@string/alert_simple"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonConfirmAlert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="test-Confirm"
                android:text="@string/alert_confirm"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_primary"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPromptAlert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:contentDescription="test-Prompt"
                android:text="@string/alert_prompt"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_primary_2"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCustomModal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="test-CustomModal"
                android:text="Show Custom Modal"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBottomSheet"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="test-BottomSheet"
                android:text="Show Bottom Sheet"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_primary"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToast"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="test-Toast"
                android:text="Show Toast"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_primary"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/toastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@color/lebyy_surface_2"
                android:contentDescription="test-ToastMessage"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="Toast: Saved successfully"
                android:textColor="@color/lebyy_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/alertResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:contentDescription="test-AlertResult"
                android:text="Result: —"
                android:textColor="@color/lebyy_accent"
                android:textSize="16sp" />
        </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Custom modal overlay (not a system dialog) — mirrors the iOS AlertsView overlay -->
    <FrameLayout
        android:id="@+id/modalBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:clickable="true"
        android:contentDescription="test-ModalBackdrop"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/customModalContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="32dp"
            android:background="@color/lebyy_surface"
            android:clickable="true"
            android:contentDescription="test-CustomModalContent"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/modalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:contentDescription="test-ModalTitle"
                android:gravity="center"
                android:text="Custom Modal"
                android:textColor="@color/lebyy_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modalBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:contentDescription="test-ModalBody"
                android:gravity="center"
                android:text="Not a system alert — custom overlay"
                android:textColor="@color/lebyy_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modalOk"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="test-ModalOK"
                android:text="OK"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modalCancel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:contentDescription="test-ModalCancel"
                android:text="Cancel"
                android:textColor="@color/lebyy_text"
                app:backgroundTint="@color/lebyy_surface_2"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/lebyy_surface"
        android:contentDescription="test-Menu-panel" />
</androidx.drawerlayout.widget.DrawerLayout>
