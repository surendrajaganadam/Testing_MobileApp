<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lebyy_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lebyy_bg_2"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/alerts_title"
            app:titleTextColor="@color/lebyy_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Practice native Android alert dialogs"
                android:textColor="@color/lebyy_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSimpleAlert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="test-Alert"
                android:text="@string/alert_simple"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonConfirmAlert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="test-Confirm"
                android:text="@string/alert_confirm"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_primary"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPromptAlert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:contentDescription="test-Prompt"
                android:text="@string/alert_prompt"
                android:textColor="@color/lebyy_bg"
                app:backgroundTint="@color/lebyy_primary_2"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/alertResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:contentDescription="test-AlertResult"
                android:text="Result: —"
                android:textColor="@color/lebyy_accent"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/lebyy_surface"
        android:contentDescription="test-Menu-panel" />
</androidx.drawerlayout.widget.DrawerLayout>
