<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bankRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    android:contentDescription="test-BankTab"
    android:orientation="vertical">

    <!-- Logged-out gate -->
    <LinearLayout
        android:id="@+id/bankGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="test-BankLoginGate"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bankLoginGateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="test-BankLoginGateTitle"
            android:text="Bank needs login"
            android:textColor="#1A1F29"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/bankGoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="test-BankGoLogin"
            android:text="Go to Login" />
    </LinearLayout>

    <!-- Logged-in dashboard -->
    <LinearLayout
        android:id="@+id/bankDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Exit Bank — hides app tabs while in bank; returns to Home -->
        <LinearLayout
            android:id="@+id/bankExitBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F6F7F9"
            android:contentDescription="test-BankExitBar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="test-BankExitBarTitle"
                android:text="Bank"
                android:textColor="#1A1F29"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bankExitBank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DB2626"
                android:contentDescription="test-ExitBank"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="Exit Bank"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Header -->
        <LinearLayout
            android:id="@+id/bankHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:contentDescription="test-BankHeader"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:id="@+id/bankMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="test-BankMenu"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☰"
                    android:textColor="#1A1F29"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu"
                    android:textColor="#1A1F29"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/bankInbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="test-BankInbox"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉"
                    android:textColor="#1A1F29"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inbox"
                    android:textColor="#1A1F29"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bankProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="test-BankProducts"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒"
                    android:textColor="#1A1F29"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Products"
                    android:textColor="#1A1F29"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bankLogOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="test-BankLogOut"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⎋"
                    android:textColor="#1A1F29"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log Out"
                    android:textColor="#1A1F29"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Accounts / Dashboard tabs -->
        <LinearLayout
            android:id="@+id/bankTopTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:contentDescription="test-BankTopTabs"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/bankTopTabAccounts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="test-BankTopTab-Accounts"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/bankTopTabAccountsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accounts"
                    android:textColor="@color/bank_tab_selected"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/bankTopTabAccountsUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/bank_tab_selected" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bankTopTabDashboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="test-BankTopTab-Dashboard"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/bankTopTabDashboardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard"
                    android:textColor="@color/bank_tab_unselected"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/bankTopTabDashboardUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DCE0E6" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/bankCenter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />
        </ScrollView>

        <!-- Footer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DCE0E6" />

        <LinearLayout
            android:id="@+id/bankFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F6F7F9"
            android:contentDescription="test-BankFooter"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/bankFooterAccounts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="test-BankFooter-Accounts"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$"
                    android:textColor="@color/bank_footer_accounts"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Accounts"
                    android:textColor="@color/bank_footer_accounts"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bankFooterPayTransfer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="test-BankFooter-PayTransfer"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⇄"
                    android:textColor="@color/bank_footer_pay"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Pay &amp; Transfer"
                    android:textColor="@color/bank_tab_unselected"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bankFooterDeposit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="test-BankFooter-Deposit"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷"
                    android:textColor="@color/bank_footer_deposit"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Deposit Checks"
                    android:textColor="@color/bank_tab_unselected"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bankFooterInvest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="test-BankFooter-Invest"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◔"
                    android:textColor="@color/bank_footer_invest"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Invest"
                    android:textColor="@color/bank_tab_unselected"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
