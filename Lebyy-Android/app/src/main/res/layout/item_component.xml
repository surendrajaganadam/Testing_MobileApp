<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lebyy_surface"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="8dp">

    <!--
      Keep the test-* id on the title TextView (not the card root) so Accessibility
      Inspector / TalkBack highlight the title text, then the subtitle below.
    -->
    <TextView
        android:id="@+id/componentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:textColor="@color/lebyy_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/componentSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="yes"
        android:textColor="@color/lebyy_muted"
        android:textSize="13sp" />
</LinearLayout>
