<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lebyy_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/loginLogo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Lebyy logo"
            android:src="@drawable/logo_lebyy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/brand_name"
            android:textColor="@color/lebyy_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="@string/brand_tagline"
            android:textColor="@color/lebyy_muted"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/lebyy_surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/lebyy_line"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/demoCredentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="test-DemoCredentials"
                android:lineSpacingExtra="6dp"
                android:padding="16dp"
                android:text="@string/demo_credentials"
                android:textColor="@color/lebyy_accent"
                android:textSize="18sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Username"
            android:textColorHint="@color/lebyy_muted"
            app:boxBackgroundColor="@color/lebyy_surface"
            app:boxStrokeColor="@color/lebyy_primary"
            app:hintTextColor="@color/lebyy_primary"
            app:placeholderText="@string/username_hint"
            app:placeholderTextColor="@color/lebyy_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="test-Username"
                android:importantForAccessibility="yes"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/lebyy_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Password"
            android:textColorHint="@color/lebyy_muted"
            app:boxBackgroundColor="@color/lebyy_surface"
            app:boxStrokeColor="@color/lebyy_primary"
            app:hintTextColor="@color/lebyy_primary"
            app:placeholderText="@string/password_hint"
            app:placeholderTextColor="@color/lebyy_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="test-Password"
                android:importantForAccessibility="yes"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textColor="@color/lebyy_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:contentDescription="test-LOGIN"
            android:text="@string/login_button"
            android:textAllCaps="true"
            android:textColor="@color/lebyy_bg"
            app:backgroundTint="@color/lebyy_accent"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/loginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FF8A80"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quickGesturesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="test-QuickGestures"
            android:text="@string/login_quick_gestures"
            android:textColor="@color/lebyy_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLongPress"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="test-LoginLongPress"
            android:text="@string/login_long_press_button"
            android:textAllCaps="true"
            android:textColor="@color/lebyy_primary"
            app:backgroundTint="@color/lebyy_surface"
            app:cornerRadius="12dp"
            app:rippleColor="@color/lebyy_primary"
            app:strokeColor="@color/lebyy_primary"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDoubleTap"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="test-LoginDoubleTap"
            android:text="@string/login_double_tap_button"
            android:textAllCaps="true"
            android:textColor="@color/lebyy_primary"
            app:backgroundTint="@color/lebyy_surface"
            app:cornerRadius="12dp"
            app:rippleColor="@color/lebyy_primary"
            app:strokeColor="@color/lebyy_primary"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/gestureResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:contentDescription="test-LoginGestureResult"
            android:gravity="center"
            android:minHeight="24dp"
            android:textColor="@color/lebyy_success"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
